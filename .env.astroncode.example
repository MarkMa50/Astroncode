# Copy this file to .env.astroncode and fill in your provider details.
# The current launch layer maps Atroncode compatibility variables into the runtime
# variables expected by the upstream engine.

# Preferred for Astron Coding Plan and other bearer-token providers.
ASTRONCODE_AUTH_TOKEN=replace-me
ASTRONCODE_BASE_URL=https://your-provider.example.com/v2
ASTRONCODE_MODEL=replace-with-your-model-id

# Optional if your provider specifically requires x-api-key semantics.
# ASTRONCODE_API_KEY=replace-me
