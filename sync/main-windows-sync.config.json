{
  "source": {
    "repository": "MarkMa50/Astroncode----src",
    "branch": "main",
    "localClone": "../Astroncode-main"
  },
  "target": {
    "repository": "MarkMa50/Astroncode",
    "branch": "windows"
  },
  "shared": {
    "include": [
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "docs/**/*.md",
      "scripts/astron-env.mjs",
      "scripts/js-ast-strings.mjs",
      "scripts/patch-runtime-branding.mjs",
      "scripts/runtime-exit-normalizer.mjs",
      "scripts/version-files.mjs",
      "scripts/ensure-local-version.mjs",
      "scripts/bump-local-version.mjs",
      "scripts/setup-wizard.mjs",
      "src/constants/querySource.ts",
      "src/types/utils.ts",
      "src/utils/bash/index.ts",
      "src/utils/bash/specs/index.ts",
      "src/utils/core/index.ts",
      "src/utils/deepLink/index.ts",
      "src/utils/dxt/index.ts",
      "src/utils/filePersistence/index.ts",
      "src/utils/fs/index.ts",
      "src/utils/git/index.ts",
      "src/utils/github/index.ts",
      "src/utils/hooks/index.ts",
      "src/utils/index.ts",
      "src/utils/mcp/index.ts",
      "src/utils/messages/index.ts",
      "src/utils/logoPageCopy.mjs",
      "src/utils/model/index.ts",
      "src/utils/nativeInstaller/index.ts",
      "src/utils/network/index.ts",
      "src/utils/permissions/index.ts",
      "src/utils/plugins/index.ts",
      "src/utils/plugins/pluginLayout.ts",
      "src/utils/powershell/index.ts",
      "src/utils/process/index.ts",
      "src/utils/processUserInput/index.ts",
      "src/utils/sandbox/index.ts",
      "src/utils/shell/index.ts",
      "src/utils/skills/index.ts",
      "src/utils/suggestions/index.ts",
      "src/utils/task/index.ts",
      "src/utils/telemetry/index.ts",
      "src/utils/teleport/index.ts",
      "src/utils/todo/index.ts",
      "src/utils/ui/index.ts",
      "src/utils/ultraplan/index.ts",
      "src/utils/validation/index.ts",
      "tests/services-api-error.test.mjs",
      "tests/services-mcp-strings.test.mjs",
      "tests/utils-config.test.mjs",
      "tests/utils-core.test.mjs",
      "tests/utils-env.test.mjs",
      "tests/utils-json-advanced.test.mjs",
      "tests/utils-log.test.mjs",
      "tests/utils-sanitization.test.mjs",
      "tests/utils-uuid.test.mjs",
      "tests/utils-validation.test.mjs",
      "tests/logo-page-copy.test.mjs",
      "tests/runtime-branding-copy.test.mjs",
      "tests/version-sync.test.mjs"
    ],
    "exclude": [
      "docs/superpowers/**"
    ]
  },
  "preserve": [
    ".claude/**",
    "artifacts/**",
    "README.md",
    "gui/**",
    "astroncode.ps1",
    "astroncode.cmd",
    "astroncode-gui.ps1",
    "astroncode-gui.sh",
    "scripts/start.mjs",
    "scripts/runtime-auto-sync.mjs",
    "tests/utils-path.test.mjs",
    "create-shortcut.ps1",
    "create-shortcut.vbs",
    "update-shortcut.ps1",
    "atroncode.ps1",
    "atroncode.cmd",
    "atroncode.sh"
  ],
  "managed": [
    {
      "path": "package.json",
      "strategy": "package-json",
      "preserveBinKeys": [
        "atroncode"
      ],
      "preserveScriptKeys": [
        "test:astron",
        "test:runtime",
        "test:sync",
        "test:version-sync",
        "sync:align",
        "sync:align:commit",
        "sync:align:dry-run",
        "sync:loop",
        "version:bump-local",
        "version:ensure-local"
      ],
      "dropSourceScriptKeys": [
        "sync:check",
        "sync:local",
        "sync:cloud",
        "version:bump-local",
        "version:ensure-local"
      ],
      "overrides": {
        "homepage": "https://github.com/MarkMa50/Astroncode",
        "bugs": {
          "url": "https://github.com/MarkMa50/Astroncode/issues"
        }
      }
    },
    {
      "path": "scripts/astron-meta.mjs",
      "strategy": "copy"
    }
  ],
  "blocked": [
    "README.md"
  ],
  "renameMap": []
}
