{
  "source": {
    "repository": "MarkMa50/Astroncode----src",
    "branch": "main",
    "localClone": "../Astroncode-main"
  },
  "target": {
    "repository": "MarkMa50/Astroncode",
    "branch": "windows"
  },
  "shared": {
    "include": [
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "docs/**/*.md",
      "scripts/astron-env.mjs",
      "scripts/version-files.mjs",
      "scripts/ensure-local-version.mjs",
      "scripts/bump-local-version.mjs",
      "tests/version-sync.test.mjs"
    ],
    "exclude": [
      "docs/superpowers/**"
    ]
  },
  "preserve": [
    ".claude/**",
    "artifacts/**",
    "README.md",
    "gui/**",
    "astroncode.ps1",
    "astroncode.cmd",
    "astroncode-gui.ps1",
    "astroncode-gui.sh",
    "scripts/start.mjs",
    "scripts/runtime-auto-sync.mjs",
    "create-shortcut.ps1",
    "create-shortcut.vbs",
    "update-shortcut.ps1",
    "atroncode.ps1",
    "atroncode.cmd",
    "atroncode.sh"
  ],
  "managed": [
    {
      "path": "package.json",
      "strategy": "package-json",
      "preserveBinKeys": [
        "atroncode"
      ],
      "preserveScriptKeys": [
        "test:astron",
        "test:runtime",
        "test:sync",
        "test:version-sync",
        "sync:align",
        "sync:align:commit",
        "sync:align:dry-run",
        "sync:loop",
        "version:bump-local",
        "version:ensure-local"
      ],
      "dropSourceScriptKeys": [
        "sync:check",
        "sync:local",
        "sync:cloud",
        "version:bump-local",
        "version:ensure-local"
      ],
      "overrides": {
        "homepage": "https://github.com/MarkMa50/Astroncode",
        "bugs": {
          "url": "https://github.com/MarkMa50/Astroncode/issues"
        }
      }
    },
    {
      "path": "scripts/astron-meta.mjs",
      "strategy": "copy"
    }
  ],
  "blocked": [
    "README.md"
  ],
  "renameMap": []
}
