{
  "name": "astroncode",
  "version": "1.0.742",
  "bin": {
    "astroncode": "scripts/start.mjs",
    "astron": "scripts/start.mjs",
    "atroncode": "scripts/start.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "author": "Astroncode",
  "license": "SEE LICENSE IN README.md",
  "description": "Astroncode terminal coding system with a swappable model provider launch layer.",
  "homepage": "https://github.com/MarkMa50/Astroncode",
  "bugs": {
    "url": "https://github.com/MarkMa50/Astroncode/issues"
  },
  "scripts": {
    "test": "node --test ./tests/*.test.mjs",
    "prepare": "node -e \"if (!process.env.AUTHORIZED) { console.error('ERROR: Direct publishing is not allowed.\\nPlease see the release workflow documentation to publish this package.'); process.exit(1); }\"",
    "test:astron": "node --test ./tests/astron-env.test.mjs",
    "test:runtime": "node --test ./tests/runtime-branding.test.mjs ./tests/runtime-guards.test.mjs",
    "test:sync": "node --test ./tests/main-windows-sync.test.mjs",
    "test:version-sync": "node --test ./tests/version-sync.test.mjs",
    "sync:align": "node ./scripts/main-windows-sync.mjs --apply",
    "sync:align:commit": "node ./scripts/main-windows-sync.mjs --apply --commit",
    "sync:align:dry-run": "node ./scripts/main-windows-sync.mjs",
    "sync:loop": "node ./scripts/runtime-auto-sync.mjs",
    "version:bump-local": "node ./scripts/bump-local-version.mjs",
    "version:ensure-local": "node ./scripts/ensure-local-version.mjs"
  },
  "dependencies": {},
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "^0.34.2",
    "@img/sharp-darwin-x64": "^0.34.2",
    "@img/sharp-linux-arm": "^0.34.2",
    "@img/sharp-linux-arm64": "^0.34.2",
    "@img/sharp-linux-x64": "^0.34.2",
    "@img/sharp-linuxmusl-arm64": "^0.34.2",
    "@img/sharp-linuxmusl-x64": "^0.34.2",
    "@img/sharp-win32-arm64": "^0.34.2",
    "@img/sharp-win32-x64": "^0.34.2"
  }
}
